  <script>
    (function () {
      // --- AUDIO & MIDI ---
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      let audioCtx = null;

      // MIDI state
      let midiAccess = null;
      let midiOutput = null;
      let midiEnabled = false;
      let midiChannel = 1; // 1..16
      let midiGateBeats = 0.25; // Default 1/16th

      // Audio state
      let audioEnabled = true;

      // Titlebar mini status
      const wtMidiLed = document.getElementById("wt-midi-led");
      const wtMidiMini = document.getElementById("wt-midi-mini");

      function initAudio() {
        if (!audioCtx) audioCtx = new AudioCtx();
        if (audioCtx.state === "suspended") audioCtx.resume();
      }

      window.addEventListener(
        "touchstart",
        function () {
          initAudio();
        },
        { once: true }
      );

      async function initMidi() {
        if (!navigator.requestMIDIAccess) return false;
        try {
          midiAccess = await navigator.requestMIDIAccess({ sysex: false });
          attachMidiHotplugHandlers();
          return true;
        } catch (e) {
          console.log("MIDI Failed", e);
          midiAccess = null;
          return false;
        }
      }

      function attachMidiHotplugHandlers() {
        if (!midiAccess) return;
        midiAccess.onstatechange = () => {
          populateMidiPortSelect();
          syncMidiStatus();
          syncTitlebarMidi();
        };
      }

      function getMidiOutputsArray() {
        if (!midiAccess) return [];
        return Array.from(midiAccess.outputs.values());
      }

      function playFreq(freq, startTime) {
        if (!audioCtx || !audioEnabled) return;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = "triangle";
        const release = 1.25;
        gain.gain.setValueAtTime(0, startTime);
        gain.gain.linearRampToValueAtTime(0.2, startTime + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.001, startTime + release);
        osc.frequency.value = freq;
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(startTime);
        osc.stop(startTime + release + 0.1);
      }

      function clampMidiChannel(ch) {
        ch = parseInt(ch, 10);
        if (Number.isNaN(ch)) return 1;
        return Math.min(16, Math.max(1, ch));
      }

      function sendMidiNote(midiVal, durationSec, velocity = 90) {
        if (!midiEnabled || !midiOutput) return;
        const ch = clampMidiChannel(midiChannel) - 1;
        const noteOn = 0x90 + ch;
        const noteOff = 0x80 + ch;
        const vel = Math.min(127, Math.max(1, velocity | 0));

        const nowMs = performance.now();
        midiOutput.send([noteOn, midiVal, vel], nowMs);
        midiOutput.send([noteOff, midiVal, 0], nowMs + durationSec * 1000);
      }

      function playMidiNotes(midiNotes, duration = 2.0) {
        initAudio();
        const now = audioCtx.currentTime;
        highlightKeys(midiNotes);
        let stagger = strumMode ? 0.06 : 0;

        let beatSec = 60 / bpm;
        let actualGateSec = beatSec * midiGateBeats;

        midiNotes.forEach((m, i) => {
          let freq = 440 * Math.pow(2, (m - 69) / 12);
          let timing = now + i * stagger;
          playFreq(freq, timing);

          const noteDelaySec = i * stagger;
          setTimeout(() => {
            sendMidiNote(m, actualGateSec);
          }, noteDelaySec * 1000);
        });
      }

      // --- UI ELEMENTS ---
      const keyboardDiv = document.getElementById("ct-keyboard");
      const centerMarker = document.getElementById("center-marker");
      const outDiv = document.getElementById("ct-output");
      const inBox = document.getElementById("ct-input");
      const theoryText = document.getElementById("theory-text");

      const helpModal = document.getElementById("help-modal");
      const midiModal = document.getElementById("midi-modal");
      const voiceModal = document.getElementById("voice-modal");

      const midiBtn = document.getElementById("midi-btn");
      const voiceBtn = document.getElementById("voice-btn");

      // MIDI modal controls
      const midiEnableBtn = document.getElementById("midi-enable-btn");
      const midiPortSelect = document.getElementById("midi-port-select");
      const midiChannelSelect = document.getElementById("midi-channel-select");
      const midiStatus = document.getElementById("midi-status");
      const closeMidiBtn = document.getElementById("close-midi-btn");

      // MIDI controls
      const audioEnableBtn = document.getElementById("audio-enable-btn");
      const midiGateSelect = document.getElementById("midi-gate-select");

      // VOICING modal controls
      const voiceBassSelect = document.getElementById("voice-bass-select");
      const voiceInvSelect = document.getElementById("voice-inv-select");
      const voiceSpreadBtn = document.getElementById("voice-spread-btn");
      const closeVoiceBtn = document.getElementById("close-voice-btn");

      let keyMap = {};
      let keyStartMidi = 36;
      let keyEndMidi = 84;

      function renderKeyboard() {
        keyboardDiv.innerHTML = "";
        keyboardDiv.appendChild(centerMarker);
        keyMap = {};
        for (let m = keyStartMidi; m <= keyEndMidi; m++) {
          let noteInOct = m % 12;
          let isBlack = [1, 3, 6, 8, 10].includes(noteInOct);
          let key = document.createElement("div");
          key.className = `key ${isBlack ? "key-black" : "key-white"}`;
          key.dataset.midi = m;
          key.addEventListener("mousedown", (e) => {
            e.preventDefault();
            setCenter(m);
          });
          key.addEventListener("touchstart", (e) => {
            e.preventDefault();
            setCenter(m);
          });
          keyboardDiv.appendChild(key);
          keyMap[m] = key;
        }
        updateCenterMarker(centerMidi);
      }

      function highlightKeys(midiNotes) {
        document.querySelectorAll(".key.active").forEach((k) => k.classList.remove("active"));
        midiNotes.forEach((m) => {
          if (keyMap[m]) keyMap[m].classList.add("active");
        });
        setTimeout(() => {
          document.querySelectorAll(".key.active").forEach((k) => k.classList.remove("active"));
        }, 1000);
      }

      function updateCenterMarker(midi) {
        if (keyMap[midi]) {
          centerMarker.style.display = "block";
          let el = keyMap[midi];
          centerMarker.style.left = el.offsetLeft + el.offsetWidth / 2 + "px";
        } else {
          centerMarker.style.display = "none";
        }
      }

      // --- THEORY LOGIC ---
      const SHARPS = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
      const FLATS  = ["C", "Db", "D", "Eb", "E", "F", "Gb", "G", "Ab", "A", "Bb", "B"];
      const SCALES = { Major: [0, 2, 4, 5, 7, 9, 11], Minor: [0, 2, 3, 5, 7, 8, 10] };

      function toSharp(note) {
        const map = { Db: "C#", Eb: "D#", Gb: "F#", Ab: "G#", Bb: "A#" };
        return map[note] || note;
      }

      // Flat-preference detection (works even though keyRoot is stored in sharps)
      const FLAT_KEY_ROOTS_SHARP = new Set(["F", "A#", "D#", "G#", "C#", "F#"]); // F, Bb, Eb, Ab, Db, Gb
      const MINOR_FLAT_PREF_SHARP = new Set(["D", "G", "C", "F", "A#"]); // Dm,Gm,Cm,Fm,Bbm(A#m)

      function prefersFlats(keyRootSharp, keyType) {
        if (keyType === "Minor" && MINOR_FLAT_PREF_SHARP.has(keyRootSharp)) return true;
        return FLAT_KEY_ROOTS_SHARP.has(keyRootSharp);
      }

      function displayNote(noteSharp, keyRootSharp, keyType) {
        if (!SHARPS.includes(noteSharp)) return noteSharp;
        const idx = SHARPS.indexOf(noteSharp);
        return prefersFlats(keyRootSharp, keyType) ? FLATS[idx] : SHARPS[idx];
      }

      // =========================================================
      // “SCHOOL” SPREADING (DROP-VOICING PRINCIPLES)
      // =========================================================
      function applyAcademicDropSpread(sortedNotes) {
        if (!sortedNotes || sortedNotes.length < 3) return sortedNotes;

        let notes = sortedNotes.slice().sort((a, b) => a - b);
        const bass = notes[0];

        function clampToRegister(n, minAbove, maxAbove) {
          while (n - bass > maxAbove) n -= 12;
          while (n - bass < minAbove) n += 12;
          return n;
        }

        for (let i = 1; i < notes.length; i++) {
          notes[i] = clampToRegister(notes[i], 3, 19);
        }
        notes.sort((a, b) => a - b);

        if (notes.length === 4) {
          const candidate = notes.slice();
          const idx = candidate.length - 2;
          candidate[idx] = candidate[idx] - 12;

          candidate[idx] = clampToRegister(candidate[idx], 3, 19);
          candidate.sort((a, b) => a - b);

          const spanCand = candidate[candidate.length - 1] - bass;

          function minUpperInterval(arr) {
            let m = 999;
            for (let i = 2; i < arr.length; i++) m = Math.min(m, arr[i] - arr[i - 1]);
            return m === 999 ? 0 : m;
          }

          const minIntNow = minUpperInterval(notes);
          const minIntCand = minUpperInterval(candidate);

          if (spanCand <= 19 && minIntCand > minIntNow) {
            notes = candidate;
          }
        }

        for (let pass = 0; pass < 3; pass++) {
          notes.sort((a, b) => a - b);
          let changed = false;
          for (let i = 2; i < notes.length; i++) {
            const gap = notes[i] - notes[i - 1];
            if (gap > 10) {
              const folded = notes[i] - 12;
              if (folded - notes[i - 1] >= 3 && folded - bass >= 3) {
                notes[i] = folded;
                changed = true;
              }
            }
          }
          if (!changed) break;
        }

        notes.sort((a, b) => a - b);
        for (let i = 1; i < notes.length; i++) {
          notes[i] = clampToRegister(notes[i], 3, 19);
        }
        notes.sort((a, b) => a - b);

        for (let i = 1; i < notes.length; i++) {
          if (notes[i] <= notes[i - 1]) {
            notes[i] += 12;
            notes[i] = clampToRegister(notes[i], 3, 19);
          }
        }
        notes.sort((a, b) => a - b);

        return notes;
      }

      // FIXED: correct 7th parsing order + #11 support (+ basic b9/#9/b13)
      function getVoicedMidi(root, qual, cMidi, bassDrop, inv = 0, spread = false) {
        const r = toSharp(root);
        const rIdx = SHARPS.indexOf(r);
        if (rIdx === -1) return [];

        let intervals = [0, 4, 7];
        if (["m", "min"].some((x) => qual.startsWith(x))) intervals = [0, 3, 7];
        if (qual.includes("dim")) intervals = [0, 3, 6];
        if (qual.includes("aug")) intervals = [0, 4, 8];
        if (qual.includes("sus4")) intervals = [0, 5, 7];
        if (qual.includes("sus2")) intervals = [0, 2, 7];

        // --- 7th logic (ORDER MATTERS) ---
        if (qual.includes("m7b5")) {
          intervals = [0, 3, 6, 10];
        } else if (qual.includes("dim7")) {
          intervals = intervals.slice(0, 3);
          intervals.push(9);
        } else if (qual.includes("Maj7")) {
          intervals.push(11);
        } else if (qual.includes("m7")) {
          intervals.push(10);
        } else if (qual.includes("7")) {
          intervals.push(10);
        }

        if (qual.includes("6")) intervals.push(9);

        // Extensions with basic alterations
        if (qual.includes("b9")) intervals.push(13);
        else if (qual.includes("#9")) intervals.push(15);
        else if (qual.includes("9")) intervals.push(14);

        if (qual.includes("#11")) intervals.push(18);
        else if (qual.includes("11")) intervals.push(17);

        if (qual.includes("b13")) intervals.push(20);
        else if (qual.includes("13")) intervals.push(21);

        // --- INVERSION LOGIC ---
        let invOffset = 0;
        if (inv === 1 && intervals.length > 1) invOffset = 1;
        else if (inv === 2 && intervals.length > 2) invOffset = 2;

        // Bass note closest to center
        let bassInterval = intervals[invOffset];
        let bassPc = (rIdx + bassInterval) % 12;
        let bassMidi = -1;
        let minBassDist = 999;

        for (let oct = 0; oct <= 9; oct++) {
          let cand = oct * 12 + bassPc;
          let dist = Math.abs(cand - cMidi);
          if (dist < minBassDist) {
            minBassDist = dist;
            bassMidi = cand;
          }
        }

        // Voice remaining notes ABOVE the bass note
        let voicedNotes = [bassMidi];
        intervals.forEach((interval, idx) => {
          if (idx === invOffset) return;
          let pc = (rIdx + interval) % 12;
          let n = -1;
          for (let oct = 0; oct <= 9; oct++) {
            let cand = oct * 12 + pc;
            if (cand > bassMidi) {
              n = cand;
              break;
            }
          }
          if (n !== -1) voicedNotes.push(n);
        });

        voicedNotes.sort((a, b) => a - b);

        if (spread) voicedNotes = applyAcademicDropSpread(voicedNotes);

        // Apply Bass Drop (kept as your design: drops ROOT in bass region)
        if (bassDrop !== 0) {
          let cOct = Math.floor(cMidi / 12);
          let targetBassOct = cOct + bassDrop;
          let bassNote = targetBassOct * 12 + rIdx;
          let lowest = Math.min(...voicedNotes);
          if (bassNote >= lowest) bassNote -= 12;
          voicedNotes.push(bassNote);
        }

        voicedNotes.sort((a, b) => a - b);
        return voicedNotes;
      }

      function midiToNoteName(midi) {
        return displayNote(SHARPS[midi % 12], keyRoot, keyType);
      }

      function getTheoryAnalysis(prevRoot, prevQual, currRoot, currQual) {
        if (!prevRoot) return "Establishes the harmonic center (Tonic function).";

        const pIdx = SHARPS.indexOf(toSharp(prevRoot));
        const cIdx = SHARPS.indexOf(toSharp(currRoot));
        const interval = (cIdx - pIdx + 12) % 12;

        let mvmt = "";
        if (interval === 5) mvmt = "Circle of Fifths movement (Strong resolution).";
        else if (interval === 7) mvmt = "Moving to the Dominant (Builds tension).";
        else if (interval === 1) mvmt = "Chromatic Step Up (Leading tone).";
        else if (interval === 11) mvmt = "Chromatic Step Down (Smooth).";
        else if (interval === 2) mvmt = "Whole Step Up.";
        else if (interval === 10) mvmt = "Whole Step Down.";
        else if ([3, 4].includes(interval)) mvmt = "Third relation (Mediants).";
        else if ([8, 9].includes(interval)) mvmt = "Third relation (Sub-mediants).";
        else if (interval === 6) mvmt = "Tritone jump (Destabilizing).";
        else if (interval === 0) {
          if (prevQual === currQual) mvmt = "Static Repetition.";
          else mvmt = "Static Root (Quality change).";
        }

        if (interval === 5 && (prevQual.includes("7") || prevQual.includes("9")) && currQual.includes("Maj"))
          return `Perfect Cadence (V -> I). ${mvmt} Resolves all tension.`;
        if (interval === 5 && prevQual.includes("m") && currQual.includes("7") && !currQual.includes("Maj"))
          return `ii-V Progression. ${mvmt} Sets up a resolution.`;
        if (interval === 11 && prevQual.includes("7") && currQual.includes("Maj"))
          return `Tritone Substitution. Resolves chromatically to target.`;
        if (interval === 7 && prevQual.includes("Maj") && currQual.includes("Maj"))
          return `Plagal Cadence (IV -> I). 'Amen' resolution.`;
        if (interval === 2 && prevQual.includes("7") && currQual.includes("Maj"))
          return `Backdoor Resolution. Surprise resolution to Tonic.`;

        return `${mvmt} connects ${prevRoot} to ${currRoot}.`;
      }

      // --- STATE ---
      let appState = "start";
      let keyRoot = null;     // stored as SHARP spelling
      let keyType = "Major";  // "Major" | "Minor"
      let currentRoot = null;
      let currentQual = null;
      let history = [];
      let suggestions = [];
      let centerNoteName = "C4";
      let centerMidi = 60;

      // Voicing state
      let bassDrop = 0;       // 0, -1, -2
      let inversionState = 0; // 0=Root,1=1st,2=2nd
      let spreadMode = true;  // ON/OFF

      let strumMode = true;
      let isPlaying = false;
      let playbackIndex = 0;
      let playbackTimer = null;
      let bpm = 90;
      let beatsPerChord = 2;

      function syncVoiceUI() {
        voiceBassSelect.value = String(bassDrop);
        voiceInvSelect.value = String(inversionState);
        voiceSpreadBtn.classList.toggle("on", !!spreadMode);
        voiceSpreadBtn.innerText = spreadMode ? "ON" : "OFF";
      }

      // --- CONTROLS ---
      document.getElementById("strum-btn").onclick = function () {
        strumMode = !strumMode;
        this.innerText = `STRUM: ${strumMode ? "ON" : "OFF"}`;
      };

      const playBtn = document.getElementById("play-btn");
      playBtn.onclick = () => {
        if (isPlaying) {
          isPlaying = false;
          clearTimeout(playbackTimer);
          playBtn.innerText = "▶ PLAY";
        } else {
          startPlayback();
        }
      };

      document.getElementById("stop-btn").onclick = () => {
        isPlaying = false;
        clearTimeout(playbackTimer);
        playbackIndex = 0;
        playBtn.innerText = "▶ PLAY";
        document.querySelectorAll(".history-item").forEach((el) => el.classList.remove("playing"));
      };

      document.getElementById("bpm-btn").onclick = function () {
        bpm += 10;
        if (bpm > 160) bpm = 60;
        this.innerText = `BPM: ${bpm}`;
      };

      document.getElementById("interval-btn").onclick = function () {
        let opts = [
          { b: 1, t: "1/4 BAR" },
          { b: 2, t: "1/2 BAR" },
          { b: 4, t: "1 BAR" },
        ];
        let cur = opts.find((o) => o.b === beatsPerChord) || opts[1];
        let nextIdx = (opts.indexOf(cur) + 1) % opts.length;
        beatsPerChord = opts[nextIdx].b;
        this.innerText = `${opts[nextIdx].t}`;
      };

      document.getElementById("help-btn").onclick = () => (helpModal.style.display = "flex");
      document.getElementById("patreon-btn").onclick = () => window.open("https://patreon.com/ezbot", "_blank");

      // --- VOICE MENU HOOKS ---
      voiceBtn.onclick = () => renderVoiceSetup();
      closeVoiceBtn.onclick = () => (voiceModal.style.display = "none");

      voiceBassSelect.onchange = () => {
        bassDrop = parseInt(voiceBassSelect.value, 10) || 0;
        if (appState === "main") renderMain(true);
      };

      voiceInvSelect.onchange = () => {
        inversionState = parseInt(voiceInvSelect.value, 10) || 0;
        if (appState === "main") renderMain(true);
      };

      voiceSpreadBtn.onclick = () => {
        spreadMode = !spreadMode;
        syncVoiceUI();
        if (appState === "main") renderMain(true);
      };

      function renderVoiceSetup() {
        voiceModal.style.display = "flex";
        syncVoiceUI();
      }

      // --- MIDI UI HOOKS ---
      midiBtn.onclick = () => renderMidiSetup();
      closeMidiBtn.onclick = () => (midiModal.style.display = "none");

      audioEnableBtn.onclick = () => {
        audioEnabled = !audioEnabled;
        audioEnableBtn.innerText = audioEnabled ? "ON" : "OFF";
        audioEnableBtn.classList.toggle("on", audioEnabled);
      };

      midiGateSelect.value = "0.25";
      midiGateSelect.onchange = () => {
        midiGateBeats = parseFloat(midiGateSelect.value);
      };

      midiEnableBtn.onclick = async () => {
        initAudio();
        const ok = midiAccess ? true : await initMidi();
        if (!ok) {
          midiEnabled = false;
          midiOutput = null;
          syncMidiEnableButton();
          syncMidiStatus("MIDI access denied or unsupported in this browser.");
          syncTitlebarMidi();
          return;
        }

        midiEnabled = !midiEnabled;

        if (midiEnabled) {
          populateMidiPortSelect();
          const outId = midiPortSelect.value;
          midiOutput = outId ? midiAccess.outputs.get(outId) : null;

          if (!midiOutput) {
            const outs = getMidiOutputsArray();
            if (outs[0]) {
              midiOutput = outs[0];
              midiPortSelect.value = outs[0].id;
            }
          }

          if (!midiOutput) {
            midiEnabled = false;
            syncMidiEnableButton();
            syncMidiStatus("No MIDI outputs found. Connect a device, then reopen MIDI setup.");
            syncTitlebarMidi();
            return;
          }
        } else {
          midiOutput = null;
        }

        syncMidiEnableButton();
        syncMidiStatus();
        syncTitlebarMidi();
      };

      midiPortSelect.onchange = () => {
        if (!midiAccess) return;
        const outId = midiPortSelect.value;
        midiOutput = outId ? midiAccess.outputs.get(outId) : null;

        if (midiEnabled && !midiOutput) midiEnabled = false;

        syncMidiEnableButton();
        syncMidiStatus();
        syncTitlebarMidi();
      };

      midiChannelSelect.onchange = () => {
        midiChannel = clampMidiChannel(midiChannelSelect.value);
        syncMidiStatus();
        syncTitlebarMidi();
      };

      function syncMidiEnableButton() {
        midiEnableBtn.classList.toggle("on", !!midiEnabled);
        midiEnableBtn.innerText = midiEnabled ? "ON" : "OFF";
      }

      function syncMidiStatus(overrideMsg) {
        const msg = overrideMsg
          ? overrideMsg
          : !navigator.requestMIDIAccess
          ? "WebMIDI not supported in this browser."
          : !midiAccess
          ? "MIDI not initialized. Click MIDI OUT to request access and populate ports."
          : (() => {
              const outs = getMidiOutputsArray();
              const outName = midiOutput ? midiOutput.name || "Unnamed Device" : "None";
              const enabled = midiEnabled ? "ENABLED" : "DISABLED";
              return `Status: ${enabled}\nPort: ${outName}\nChannel: ${clampMidiChannel(midiChannel)}\nOutputs detected: ${outs.length}`;
            })();

        midiStatus.innerText = msg;
      }

      function syncTitlebarMidi() {
        const on = !!midiEnabled && !!midiOutput;
        wtMidiLed.classList.toggle("on", on);
        const portName = midiOutput ? midiOutput.name || "Unnamed" : "None";
        wtMidiMini.textContent = on ? `ON · CH ${clampMidiChannel(midiChannel)} · ${portName}` : "OFF";
      }

      function populateMidiPortSelect() {
        midiPortSelect.innerHTML = "";

        if (!midiAccess) {
          const opt = document.createElement("option");
          opt.value = "";
          opt.textContent = "MIDI not initialized";
          midiPortSelect.appendChild(opt);
          return;
        }

        const outs = getMidiOutputsArray();

        if (outs.length === 0) {
          const opt = document.createElement("option");
          opt.value = "";
          opt.textContent = "No MIDI outputs found";
          midiPortSelect.appendChild(opt);
          return;
        }

        outs.forEach((o) => {
          const opt = document.createElement("option");
          opt.value = o.id;
          opt.textContent = o.name || `MIDI Output (${o.id})`;
          midiPortSelect.appendChild(opt);
        });

        if (midiOutput && midiAccess.outputs.get(midiOutput.id)) {
          midiPortSelect.value = midiOutput.id;
        } else {
          midiPortSelect.value = outs[0].id;
        }
      }

      function populateMidiChannelSelect() {
        midiChannelSelect.innerHTML = "";
        for (let ch = 1; ch <= 16; ch++) {
          const opt = document.createElement("option");
          opt.value = String(ch);
          opt.textContent = String(ch);
          midiChannelSelect.appendChild(opt);
        }
        midiChannelSelect.value = String(clampMidiChannel(midiChannel));
      }

      async function renderMidiSetup() {
        midiModal.style.display = "flex";
        populateMidiChannelSelect();
        syncMidiEnableButton();
        syncMidiStatus();

        if (!midiAccess && navigator.requestMIDIAccess) {
          const ok = await initMidi();
          if (ok) {
            populateMidiPortSelect();
            if (midiEnabled) {
              const outId = midiPortSelect.value;
              midiOutput = outId ? midiAccess.outputs.get(outId) : null;
            }
            syncMidiStatus();
          } else {
            populateMidiPortSelect();
            syncMidiStatus("MIDI access denied or unavailable.");
          }
        } else {
          populateMidiPortSelect();
          syncMidiStatus();
        }

        syncTitlebarMidi();
      }

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          if (helpModal.style.display === "flex") helpModal.style.display = "none";
          if (midiModal.style.display === "flex") midiModal.style.display = "none";
          if (voiceModal.style.display === "flex") voiceModal.style.display = "none";
        }
      });

      // --- PLAYBACK ---
      function startPlayback() {
        if (history.length === 0) return;
        isPlaying = true;
        if (playbackIndex >= history.length) playbackIndex = 0;
        playBtn.innerText = "⏸ PAUSE";
        playNextStep();
      }

      function playNextStep() {
        if (!isPlaying) return;
        if (playbackIndex >= history.length) {
          isPlaying = false;
          playBtn.innerText = "▶ PLAY";
          return;
        }

        let h = history[playbackIndex];
        let midi;
        if (h.locked && h.lockedMidi) midi = h.lockedMidi;
        else midi = getVoicedMidi(h.root, h.qual, centerMidi, bassDrop, inversionState, spreadMode);

        let historyEls = document.querySelectorAll(".history-item");
        historyEls.forEach((el) => el.classList.remove("playing"));
        if (historyEls[playbackIndex]) historyEls[playbackIndex].classList.add("playing");

        let duration = (60 / bpm) * beatsPerChord;
        playMidiNotes(midi, duration);

        playbackIndex++;
        playbackTimer = setTimeout(playNextStep, duration * 1000);
      }

      function setCenter(midi) {
        centerMidi = midi;
        let octave = Math.floor(midi / 12) - 1;
        centerNoteName = SHARPS[midi % 12] + octave;
        updateCenterMarker(centerMidi);
        initAudio();
        playFreq(440 * Math.pow(2, (midi - 69) / 12), audioCtx.currentTime);
        if (appState === "main") renderMain(true);
        else renderStart();
      }

      function print(text, cssClass = "") {
        const span = document.createElement("div");
        span.innerHTML = text;
        if (cssClass) span.className = cssClass;
        outDiv.appendChild(span);
        outDiv.scrollTop = outDiv.scrollHeight;
      }
      function clear() {
        outDiv.innerHTML = "";
      }

      function renderStart() {
        appState = "start";
        clear();
        print(`[C]ENTER: ${centerNoteName} | [H]ELP | [M]IDI | [V]OICE`, "");
        print("");
        print("INITIATE: ENTER CHORD (e.g. Gm6)", "");
        print("OR PRESS [ENTER] FOR RANDOM START", "");
        theoryText.innerText = "Welcome. Enter a chord to begin analysis.";
      }

      function removeHistoryAt(index) {
        if (index < 0 || index >= history.length) return;

        history.splice(index, 1);

        if (playbackIndex > index) playbackIndex = Math.max(0, playbackIndex - 1);
        if (playbackIndex >= history.length) playbackIndex = 0;

        if (history.length === 0) {
          isPlaying = false;
          clearTimeout(playbackTimer);
          playbackIndex = 0;
          keyRoot = null;
          currentRoot = null;
          currentQual = null;
          suggestions = [];
          renderStart();
          return;
        }

        const last = history[history.length - 1];
        currentRoot = last.root;
        currentQual = last.qual;
        suggestions = [];
        renderMain(true);
      }

      function renderMain(keepScroll = false) {
        let scrollPos = outDiv.scrollTop;
        appState = "main";
        clear();

        let dispKey = displayNote(keyRoot, keyRoot, keyType);
        print(`KEY: ${dispKey} ${keyType}`, "");

        const histContainer = document.createElement("div");

        history.forEach((h, i) => {
          let span = document.createElement("div");
          span.className = "history-item";
          if (h.locked) span.classList.add("locked");
          let lockIcon = h.locked ? "*" : "";
          span.innerText = `${h.display}${lockIcon}`;

          span.onclick = (e) => {
            if (e.ctrlKey) {
              removeHistoryAt(i);
              return;
            }

            if (e.shiftKey) {
              h.locked = !h.locked;
              if (h.locked) h.lockedMidi = getVoicedMidi(h.root, h.qual, centerMidi, bassDrop, inversionState, spreadMode);
              else h.lockedMidi = null;
              renderMain(true);
              return;
            }

            let midi = h.locked && h.lockedMidi ? h.lockedMidi : getVoicedMidi(h.root, h.qual, centerMidi, bassDrop, inversionState, spreadMode);
            playMidiNotes(midi);
          };

          span.onmouseenter = () => {
            let prev = history[i - 1];
            let t = getTheoryAnalysis(prev ? prev.root : null, prev ? prev.qual : null, h.root, h.qual);
            theoryText.innerText = `[STEP ${i + 1}]: ${t}`;
          };
          span.onmouseleave = () => resetTheoryText();

          histContainer.appendChild(span);
          if (i < history.length - 1) {
            let arrow = document.createElement("span");
            arrow.innerText = " -> ";
            arrow.style.color = "rgba(197,206,232,0.35)";
            histContainer.appendChild(arrow);
          }
        });
        outDiv.appendChild(histContainer);

        let sep = document.createElement("div");
        sep.className = "history-separator";
        sep.innerText = "SUGGESTIONS";
        outDiv.appendChild(sep);

        if (suggestions.length === 0) generateSuggestions();

        suggestions.forEach((s, i) => {
          s.midiArr = getVoicedMidi(s.root, s.qual, centerMidi, bassDrop, inversionState, spreadMode);
          s.notesStr = s.midiArr.map((m) => midiToNoteName(m)).join("-");

          let row = document.createElement("div");
          row.className = "suggestion-row";

          let tagClass = "t-dia";
          if (s.type.includes("Res")) tagClass = "t-res";
          else if (s.type.includes("Sec")) tagClass = "t-sec";
          else if (s.type.includes("Bor")) tagClass = "t-bor";
          else if (s.type.includes("Tri")) tagClass = "t-tri";
          else if (s.type.includes("Cir")) tagClass = "t-cir";
          else if (s.type.includes("Tonic")) tagClass = "t-res";

          row.innerHTML = `
            <span class="s-idx">${i + 1}</span>
            <span class="type-tag ${tagClass}">${s.type}</span>
            <span class="s-name">${s.display}</span>
            <span class="s-notes">♪ ${s.notesStr}</span>
          `;

          row.onclick = (e) => {
            if (e.shiftKey) {
              selectSuggestion(s);
            } else {
              playMidiNotes(s.midiArr);
            }
          };

          row.onmouseenter = () => {
            let t = getTheoryAnalysis(currentRoot, currentQual, s.root, s.qual);
            theoryText.innerText = `[OPTION ${i + 1}]: ${t}`;
          };
          row.onmouseleave = () => resetTheoryText();

          outDiv.appendChild(row);
        });

        outDiv.scrollTop = keepScroll ? scrollPos : outDiv.scrollTop;
        resetTheoryText();
      }

      function selectSuggestion(s) {
        currentRoot = s.root;
        currentQual = s.qual;
        suggestions = [];
        history.push({
          display: s.display,
          root: s.root,
          qual: s.qual,
          locked: false,
          lockedMidi: null,
        });
        playMidiNotes(s.midiArr);
        renderMain();
      }

      function resetTheoryText() {
        if (history.length > 0) {
          let curr = history[history.length - 1];
          let prev = history.length > 1 ? history[history.length - 2] : null;
          let t = getTheoryAnalysis(prev ? prev.root : null, prev ? prev.qual : null, curr.root, curr.qual);
          theoryText.innerText = t;
        }
      }

      function generateSuggestions() {
        suggestions = [];
        let rSharp = toSharp(currentRoot);
        let kSharp = toSharp(keyRoot);
        let scaleInts = SCALES[keyType];
        let kIdx = SHARPS.indexOf(kSharp);
        let scaleNotes = scaleInts.map((i) => SHARPS[(kIdx + i) % 12]);

        const getIntNote = (r, i) => SHARPS[(SHARPS.indexOf(r) + i) % 12];
        const getRandom = (arr) => arr[Math.floor(Math.random() * arr.length)];

        let diatonicPool = [];
        let exoticPool = [];

        if (!scaleNotes.includes(rSharp) || Math.random() > 0.6) {
          let q = keyType === "Major" ? getRandom(["Maj7", "Maj9", "6/9"]) : getRandom(["m7", "m9", "m11"]);
          diatonicPool.push({ root: kSharp, qual: q, type: "Tonic (I)" });
        }

        let fourth = getIntNote(rSharp, 5);
        let fQual = "Maj7";
        if (scaleNotes.indexOf(fourth) === -1) {
          exoticPool.push({ root: fourth, qual: "7", type: "Circle (Non-Dia)" });
        } else {
          if (keyType === "Major") {
            if (scaleNotes.indexOf(fourth) === 4) fQual = "7";
            else if (scaleNotes.indexOf(fourth) === 1) fQual = "m7";
          }
          diatonicPool.push({ root: fourth, qual: fQual, type: "Circle (4th)" });
        }

        exoticPool.push({ root: getIntNote(rSharp, 2), qual: getRandom(["7", "9", "13"]), type: "Secondary Dom" });

        if (keyType === "Major") {
          exoticPool.push({ root: getIntNote(kSharp, 8), qual: "Maj7", type: "Borrowed (bVI)" });
          exoticPool.push({ root: getIntNote(kSharp, 10), qual: "7", type: "Borrowed (bVII)" });
          exoticPool.push({ root: getIntNote(kSharp, 5), qual: "m7", type: "Borrowed (iv)" });
        }

        exoticPool.push({ root: getIntNote(rSharp, 6), qual: "7", type: "Tritone Sub" });

        scaleNotes.forEach((note, idx) => {
          if (note === rSharp) return;
          let q = "m7";
          if (keyType === "Major") {
            if ([0, 3].includes(idx)) q = "Maj7";
            if ([1, 2, 5].includes(idx)) q = "m7";
            if (idx === 4) q = "7";
          } else {
            if ([2, 5].includes(idx)) q = "Maj7";
          }
          diatonicPool.push({ root: note, qual: q, type: "Diatonic" });
        });

        let finals = [];
        let res = diatonicPool.find((p) => p.type === "Tonic (I)");
        if (res) finals.push(res);

        diatonicPool = diatonicPool.filter((p) => p.type !== "Tonic (I)");
        diatonicPool.sort(() => 0.5 - Math.random());
        if (diatonicPool[0]) finals.push(diatonicPool[0]);
        if (diatonicPool[1]) finals.push(diatonicPool[1]);

        exoticPool.sort(() => 0.5 - Math.random());
        exoticPool.forEach((p) => finals.push(p));
        diatonicPool.forEach((p) => finals.push(p));

        let unique = [];
        finals.forEach((f) => {
          if (f.root === currentRoot && f.qual === currentQual) return;
          // FIX: dedupe by root+qual (not just root)
          if (!unique.some((u) => u.root === f.root && u.qual === f.qual)) unique.push(f);
        });

        suggestions = unique.slice(0, 8);
        suggestions.forEach((s) => {
          s.display = displayNote(s.root, keyRoot, keyType) + s.qual;
        });
      }

      function handleInput(val) {
        val = val.trim();
        if (!val) return;

        if (val.toLowerCase() === "h") {
          helpModal.style.display = "flex";
          return;
        }
        if (val.toLowerCase() === "m") {
          renderMidiSetup();
          return;
        }
        if (val.toLowerCase() === "v") {
          renderVoiceSetup();
          return;
        }
        if (val.toLowerCase() === "q" || val === "0") {
          history = [];
          keyRoot = null;
          currentRoot = null;
          currentQual = null;
          suggestions = [];
          renderStart();
          return;
        }

        if (appState === "start") {
          let match = val.match(/^([A-Ga-g])([#bBs]?)(.*)/);
          if (match) {
            let r = match[1].toUpperCase() + match[2].replace("s", "#");
            let q = match[3] || "Maj";
            const isMinorQuality = /^(m|min)/.test(q) && !/Maj/.test(q);
            setupProgression(toSharp(r), q, isMinorQuality ? "Minor" : "Major");
          }
          return;
        }

        if (appState === "main") {
          if (parseInt(val) >= 1 && parseInt(val) <= 8) {
            let idx = parseInt(val) - 1;
            if (suggestions[idx]) {
              let s = suggestions[idx];
              currentRoot = s.root;
              currentQual = s.qual;
              suggestions = [];
              history.push({ display: s.display, root: s.root, qual: s.qual, locked: false, lockedMidi: null });
              playMidiNotes(s.midiArr);
              renderMain();
            }
          }
        }
      }

      function triggerRandomStart() {
        if (appState === "start") {
          let r = SHARPS[Math.floor(Math.random() * 12)];
          let q = ["Maj9", "m9", "m11", "6/9", "Maj7#11"][Math.floor(Math.random() * 5)];
          const isMinorQuality = /^(m|min)/.test(q) && !/Maj/.test(q);
          setupProgression(r, q, isMinorQuality ? "Minor" : "Major");
        }
      }

      function setupProgression(r, q, type) {
        keyRoot = r;
        keyType = type;
        currentRoot = r;
        currentQual = q;
        suggestions = [];

        history.push({
          display: displayNote(r, keyRoot, keyType) + q,
          root: r,
          qual: q,
          locked: false,
          lockedMidi: null
        });

        playMidiNotes(getVoicedMidi(r, q, centerMidi, bassDrop, inversionState, spreadMode));
        renderMain();
      }

      inBox.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          initAudio();
          if (inBox.value.trim() === "") {
            if (appState === "start") triggerRandomStart();
            else handleInput("");
          } else {
            handleInput(inBox.value);
          }
          inBox.value = "";
        }
      });

      renderKeyboard();
      renderStart();
      syncTitlebarMidi();
      syncVoiceUI();
    })();
  </script>
</div>
