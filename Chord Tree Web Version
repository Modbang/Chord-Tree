<div id="chord-tree-wrapper">
  <style>
    /* =========================================================
       WINDOWS TERMINAL (2025-ish) SKIN
    ========================================================= */

    :root {
      /* Core */
      --wt-bg: #0b0f14;
      --wt-surface: rgba(18, 22, 30, 0.72);
      --wt-surface-2: rgba(18, 22, 30, 0.86);
      --wt-border: rgba(255, 255, 255, 0.10);
      --wt-border-2: rgba(255, 255, 255, 0.14);
      --wt-shadow: 0 18px 60px rgba(0, 0, 0, 0.55);
      --wt-radius: 14px;
      --wt-radius-sm: 10px;

      /* Text */
      --wt-fg: rgba(245, 247, 255, 0.92);
      --wt-dim: rgba(197, 206, 232, 0.60);
      --wt-dimmer: rgba(197, 206, 232, 0.42);

      /* Accent + focus */
      --wt-accent: #4cc2ff;
      --wt-focus: 0 0 0 2px rgba(76, 194, 255, 0.35), 0 0 0 1px rgba(255, 255, 255, 0.12) inset;

      /* Terminal-ish font stacks */
      --wt-ui-font: "Segoe UI Variable", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
      --wt-mono: "Cascadia Mono", "Cascadia Code", ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono",
        monospace;

      /* Your existing functional colors (kept) */
      --c-res: #50fa7b;
      --c-dia: #bd93f9;
      --c-sec: #ffb86c;
      --c-bor: #8be9fd;
      --c-tri: #ff5555;
      --c-cir: #ff79c6;

      /* Old vars mapped to new */
      --bg-color: var(--wt-bg);
      --border-color: var(--wt-border);
      --c-fg: var(--wt-fg);
      --c-dim: var(--wt-dim);
    }

    #chord-tree-wrapper {
      background: radial-gradient(1200px 900px at 12% -10%, rgba(76, 194, 255, 0.18), transparent 55%),
        radial-gradient(900px 700px at 90% 0%, rgba(255, 121, 198, 0.12), transparent 60%),
        linear-gradient(180deg, rgba(12, 16, 22, 0.92), rgba(10, 12, 16, 0.92));
      color: var(--wt-fg);
      font-family: var(--wt-ui-font);
      padding: 14px;
      border: 1px solid var(--wt-border);
      border-radius: var(--wt-radius);
      width: 100%;
      max-width: 900px;
      height: 900px;
      max-height: 95dvh;
      margin: 0 auto;
      box-sizing: border-box;
      box-shadow: var(--wt-shadow);
      display: flex;
      flex-direction: column;
      position: relative;
      user-select: none;
      overflow: hidden;
      -webkit-tap-highlight-color: transparent;
    }

    #chord-tree-wrapper::before {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.18);
      backdrop-filter: blur(18px) saturate(140%);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
      pointer-events: none;
    }

    #chord-tree-wrapper > * {
      position: relative;
      z-index: 1;
    }

    /* =========================================================
       TITLE BAR
    ========================================================= */
    #ct-titlebar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 10px 12px;
      border: 1px solid var(--wt-border);
      border-radius: var(--wt-radius-sm);
      background: linear-gradient(180deg, rgba(18, 22, 30, 0.75), rgba(18, 22, 30, 0.45));
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.22);
      flex-shrink: 0;
    }

    .wt-left {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      padding-left: 4px;
    }

    .wt-title {
      font-family: var(--wt-ui-font);
      font-weight: 700;
      letter-spacing: 0.6px;
      font-size: 13px;
      color: rgba(245, 247, 255, 0.88);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .wt-title .by {
      font-weight: 600;
      opacity: 0.65;
      margin-left: 10px;
    }

    .wt-right {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: var(--wt-mono);
      font-size: 12px;
      color: var(--wt-dim);
      white-space: nowrap;
    }

    .wt-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid var(--wt-border);
      background: rgba(10, 12, 16, 0.35);
    }

    .wt-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-weight: 700;
      letter-spacing: 0.4px;
      color: rgba(245, 247, 255, 0.86);
    }

    .wt-led {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: rgba(197, 206, 232, 0.45);
      box-shadow: 0 0 10px rgba(197, 206, 232, 0.18);
    }
    .wt-led.on {
      background: rgba(76, 194, 255, 0.95);
      box-shadow: 0 0 14px rgba(76, 194, 255, 0.35);
    }

    #ct-header-title {
      display: none;
    }

    /* =========================================================
       CONTROLS
    ========================================================= */
    #ct-controls {
      display: flex;
      flex-wrap: nowrap;
      gap: 8px;
      margin: 12px 0 12px 0;
      padding: 10px 10px;
      background: linear-gradient(180deg, rgba(18, 22, 30, 0.62), rgba(18, 22, 30, 0.38));
      border: 1px solid var(--wt-border);
      border-radius: var(--wt-radius-sm);
      align-items: center;
      flex-shrink: 0;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      justify-content: center;
    }

    #ct-controls::-webkit-scrollbar,
    #ct-output::-webkit-scrollbar,
    .modal-content::-webkit-scrollbar {
      height: 10px;
      width: 10px;
    }
    #ct-controls::-webkit-scrollbar-thumb,
    #ct-output::-webkit-scrollbar-thumb,
    .modal-content::-webkit-scrollbar-thumb {
      background: rgba(197, 206, 232, 0.28);
      border-radius: 999px;
      border: 2px solid rgba(0, 0, 0, 0);
      background-clip: padding-box;
    }
    #ct-controls::-webkit-scrollbar-track,
    #ct-output::-webkit-scrollbar-track,
    .modal-content::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.25);
      border-radius: 999px;
    }

    .ctrl-btn {
      background: rgba(10, 12, 16, 0.38);
      border: 1px solid var(--wt-border);
      color: rgba(245, 247, 255, 0.82);
      cursor: pointer;
      height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-family: var(--wt-ui-font);
      font-weight: 700;
      border-radius: 10px;
      transition: transform 0.08s ease, background 0.12s ease, border-color 0.12s ease, box-shadow 0.12s ease;
      font-size: 11px;
      white-space: nowrap;
      padding: 0 12px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      flex: 0 0 auto;
    }
    .ctrl-btn:hover {
      border-color: rgba(255, 255, 255, 0.22);
      background: rgba(10, 12, 16, 0.58);
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06) inset;
    }
    .ctrl-btn:active {
      transform: translateY(1px);
    }
    .ctrl-btn:focus-visible {
      outline: none;
      box-shadow: var(--wt-focus);
    }

    .btn-play {
      border-color: rgba(255, 184, 108, 0.35);
      color: rgba(255, 184, 108, 0.95);
    }
    .btn-play:hover {
      background: rgba(255, 184, 108, 0.16);
    }

    .btn-stop {
      border-color: rgba(255, 85, 85, 0.35);
      color: rgba(255, 85, 85, 0.95);
    }
    .btn-stop:hover {
      background: rgba(255, 85, 85, 0.14);
    }

    .btn-strum {
      border-color: rgba(189, 147, 249, 0.35);
      color: rgba(189, 147, 249, 0.95);
    }
    .btn-strum:hover {
      background: rgba(189, 147, 249, 0.14);
    }

    .btn-help {
      border-color: rgba(255, 255, 255, 0.28);
      color: rgba(255, 255, 255, 0.9);
      font-weight: 800;
    }
    .btn-help:hover {
      background: rgba(255, 255, 255, 0.10);
    }

    .btn-patreon {
      border-color: rgba(255, 85, 85, 0.32);
      color: rgba(255, 85, 85, 0.9);
    }
    .btn-patreon:hover {
      background: rgba(255, 85, 85, 0.12);
    }

    .btn-midi {
      border-color: rgba(255, 121, 198, 0.35);
      color: rgba(255, 121, 198, 0.95);
    }
    .btn-midi:hover {
      background: rgba(255, 121, 198, 0.12);
    }

    .btn-voice {
      border-color: rgba(139, 233, 253, 0.35);
      color: rgba(139, 233, 253, 0.95);
    }
    .btn-voice:hover {
      background: rgba(139, 233, 253, 0.12);
    }

    /* =========================================================
       KEYBOARD
    ========================================================= */
    #ct-keyboard {
      height: 110px;
      width: 100%;
      margin-bottom: 12px;
      position: relative;
      background: linear-gradient(180deg, rgba(18, 22, 30, 0.78), rgba(18, 22, 30, 0.50));
      border-radius: var(--wt-radius-sm);
      border: 1px solid var(--wt-border);
      display: flex;
      justify-content: center;
      padding: 10px 6px;
      flex-shrink: 0;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35) inset, 0 10px 30px rgba(0, 0, 0, 0.25);
      overflow: hidden;
    }

    .key {
      position: relative;
      float: left;
      cursor: pointer;
      border-radius: 0 0 6px 6px;
      margin: 0 1px;
      transition: background 0.1s, transform 0.08s;
    }
    .key:active {
      transform: translateY(1px);
    }
    .key-white {
      width: 2.5%;
      height: 100%;
      background: rgba(235, 240, 255, 0.78);
      border: 1px solid rgba(0, 0, 0, 0.45);
      z-index: 1;
      box-shadow: 0 -1px 0 rgba(255, 255, 255, 0.35) inset, 0 -10px 25px rgba(0, 0, 0, 0.18) inset;
    }
    .key-black {
      width: 1.8%;
      height: 60%;
      background: rgba(10, 12, 16, 0.92);
      border: 1px solid rgba(0, 0, 0, 0.75);
      z-index: 2;
      margin-left: -1.25%;
      margin-right: -1.25%;
      box-shadow: 0 -1px 0 rgba(255, 255, 255, 0.08) inset, 0 -10px 25px rgba(0, 0, 0, 0.35) inset;
    }
    .key.active {
      background: rgba(76, 194, 255, 0.9) !important;
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.35) inset, 0 0 18px rgba(76, 194, 255, 0.55);
      border-color: rgba(255, 255, 255, 0.45) !important;
    }

    #center-marker {
      position: absolute;
      bottom: 8px;
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: rgba(76, 194, 255, 0.95);
      z-index: 10;
      transform: translateX(-50%);
      transition: left 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      pointer-events: none;
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.30) inset, 0 0 16px rgba(76, 194, 255, 0.45);
    }

    /* =========================================================
       OUTPUT
    ========================================================= */
    #ct-output {
      flex-grow: 1;
      overflow-y: auto;
      margin-bottom: 10px;
      padding: 10px 10px 0 10px;
      scrollbar-width: thin;
      scrollbar-color: rgba(197, 206, 232, 0.28) rgba(0, 0, 0, 0.2);
      -webkit-overflow-scrolling: touch;

      border: 1px solid var(--wt-border);
      border-radius: var(--wt-radius-sm);
      background: linear-gradient(180deg, rgba(10, 12, 16, 0.35), rgba(10, 12, 16, 0.18));
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.04) inset;
      font-family: var(--wt-mono);
    }

    .history-item {
      display: inline-block;
      padding: 7px 10px;
      margin: 4px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: rgba(197, 206, 232, 0.72);
      border-radius: 10px;
      cursor: pointer;
      transition: background 0.12s, border-color 0.12s, transform 0.08s, color 0.12s;
      font-size: 13px;
      background: rgba(0, 0, 0, 0.20);
    }
    .history-item:hover,
    .history-item:active {
      border-color: rgba(76, 194, 255, 0.35);
      color: rgba(245, 247, 255, 0.92);
      background: rgba(76, 194, 255, 0.08);
    }
    .history-item:active {
      transform: translateY(1px);
    }
    .history-item.playing {
      border-color: rgba(255, 184, 108, 0.40);
      color: rgba(255, 184, 108, 0.95);
      background: rgba(255, 184, 108, 0.10);
      box-shadow: 0 0 18px rgba(255, 184, 108, 0.16);
    }
    .history-item.locked {
      border-color: rgba(255, 85, 85, 0.42);
      color: rgba(255, 85, 85, 0.92);
      background: rgba(255, 85, 85, 0.08);
    }

    .history-separator {
      display: flex;
      align-items: center;
      color: rgba(197, 206, 232, 0.58);
      font-size: 11px;
      margin: 18px 0 10px 0;
      letter-spacing: 1.6px;
      text-transform: uppercase;
    }
    .history-separator::before,
    .history-separator::after {
      content: "";
      flex: 1;
      border-bottom: 1px solid rgba(255, 255, 255, 0.10);
      margin: 0 10px;
    }

    .suggestion-row {
      display: grid;
      grid-template-columns: 30px 160px 80px 1fr;
      align-items: center;
      padding: 10px 6px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      cursor: pointer;
      font-size: 13px;
      transition: background 0.12s;
      border-radius: 10px;
      margin: 2px 0;
    }
    .suggestion-row:hover,
    .suggestion-row:active {
      background: rgba(255, 255, 255, 0.05);
    }

    .s-idx {
      color: rgba(197, 206, 232, 0.55);
      font-weight: 800;
      font-size: 12px;
    }
    .s-name {
      font-weight: 800;
      font-size: 14px;
      color: rgba(245, 247, 255, 0.92);
      letter-spacing: 0.2px;
    }
    .s-notes {
      font-size: 12px;
      color: rgba(197, 206, 232, 0.55);
      opacity: 1;
      font-family: var(--wt-mono);
    }

    .type-tag {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.6px;
    }
    .t-res { color: rgba(80, 250, 123, 0.95); }
    .t-dia { color: rgba(189, 147, 249, 0.95); }
    .t-sec { color: rgba(255, 184, 108, 0.95); }
    .t-bor { color: rgba(139, 233, 253, 0.95); }
    .t-tri { color: rgba(255, 85, 85, 0.95); }
    .t-cir { color: rgba(255, 121, 198, 0.95); }

    /* =========================================================
       THEORY BOX
    ========================================================= */
    #ct-theory-box {
      border: 1px solid var(--wt-border);
      border-radius: var(--wt-radius-sm);
      background: linear-gradient(180deg, rgba(18, 22, 30, 0.62), rgba(18, 22, 30, 0.38));
      padding: 12px 14px;
      min-height: 44px;
      display: flex;
      align-items: center;
      font-size: 13px;
      color: rgba(245, 247, 255, 0.86);
      margin-bottom: 12px;
      flex-shrink: 0;
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.04) inset;
      font-family: var(--wt-mono);
    }
    .theory-label {
      color: rgba(76, 194, 255, 0.95);
      font-weight: 900;
      margin-right: 12px;
      font-size: 12px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }

    /* =========================================================
       INPUT
    ========================================================= */
    #ct-input-line {
      display: flex;
      border-top: 1px solid rgba(255, 255, 255, 0.10);
      padding-top: 12px;
      align-items: center;
      flex-shrink: 0;
      gap: 10px;
      font-family: var(--wt-mono);
    }
    #ct-prompt {
      color: rgba(76, 194, 255, 0.95);
      font-weight: 900;
      font-size: 14px;
      letter-spacing: 0.4px;
    }
    #ct-input {
      background: rgba(10, 12, 16, 0.30);
      border: 1px solid rgba(255, 255, 255, 0.10);
      color: rgba(245, 247, 255, 0.92);
      font-family: var(--wt-mono);
      font-size: 14px;
      flex-grow: 1;
      outline: none;
      padding: 10px 12px;
      border-radius: 10px;
      transition: box-shadow 0.12s ease, border-color 0.12s ease, background 0.12s ease;
    }
    #ct-input:focus {
      border-color: rgba(76, 194, 255, 0.35);
      box-shadow: var(--wt-focus);
      background: rgba(10, 12, 16, 0.40);
    }
    #ct-input::placeholder {
      color: rgba(197, 206, 232, 0.42);
      opacity: 1;
      font-style: normal;
    }

    /* =========================================================
       MODALS
    ========================================================= */
    .ct-modal {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.65);
      z-index: 200;
      display: none;
      justify-content: center;
      align-items: center;
      backdrop-filter: blur(16px) saturate(130%);
      -webkit-backdrop-filter: blur(16px) saturate(130%);
    }

    .modal-content {
      background: linear-gradient(180deg, rgba(18, 22, 30, 0.90), rgba(18, 22, 30, 0.72));
      border: 1px solid rgba(255, 255, 255, 0.16);
      padding: 18px;
      border-radius: 16px;
      width: 92%;
      max-width: 600px;
      box-shadow: 0 20px 70px rgba(0, 0, 0, 0.55);
      color: rgba(245, 247, 255, 0.92);
      max-height: 90vh;
      overflow-y: auto;
      font-family: var(--wt-ui-font);
    }

    .modal-title {
      color: rgba(245, 247, 255, 0.92);
      font-size: 14px;
      margin-bottom: 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.10);
      padding-bottom: 10px;
      letter-spacing: 1.2px;
      text-align: left;
      font-weight: 800;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .modal-title .hint {
      font-family: var(--wt-mono);
      font-weight: 700;
      font-size: 12px;
      color: rgba(197, 206, 232, 0.58);
      text-transform: none;
      letter-spacing: 0;
      white-space: nowrap;
    }

    .help-table {
      display: table;
      width: 100%;
      border-collapse: collapse;
      font-family: var(--wt-ui-font);
    }
    .help-row { display: table-row; }
    .help-cell-key {
      display: table-cell;
      padding: 8px 0;
      width: 130px;
      vertical-align: top;
    }
    .help-cell-desc {
      display: table-cell;
      padding: 8px 0;
      color: rgba(197, 206, 232, 0.70);
      font-size: 13px;
      line-height: 1.45;
    }

    .key-badge {
      background: rgba(10, 12, 16, 0.35);
      color: rgba(245, 247, 255, 0.88);
      padding: 4px 8px;
      border-radius: 10px;
      font-size: 12px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      font-weight: 800;
      display: inline-block;
      font-family: var(--wt-mono);
      letter-spacing: 0.2px;
    }

    .close-help {
      margin-top: 16px;
      width: 100%;
      padding: 11px 12px;
      background: rgba(76, 194, 255, 0.18);
      color: rgba(245, 247, 255, 0.92);
      border: 1px solid rgba(76, 194, 255, 0.30);
      font-weight: 900;
      cursor: pointer;
      border-radius: 12px;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      transition: background 0.12s ease, border-color 0.12s ease, transform 0.08s ease;
      font-family: var(--wt-ui-font);
    }
    .close-help:hover {
      background: rgba(76, 194, 255, 0.24);
      border-color: rgba(76, 194, 255, 0.40);
    }
    .close-help:active { transform: translateY(1px); }
    .close-help:focus-visible { outline: none; box-shadow: var(--wt-focus); }

    .midi-section {
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(0, 0, 0, 0.18);
      border-radius: 14px;
      padding: 14px;
      margin-top: 12px;
    }
    .midi-label {
      font-weight: 900;
      letter-spacing: 1.2px;
      color: rgba(255, 121, 198, 0.92);
      font-size: 12px;
      margin-bottom: 10px;
      text-transform: uppercase;
    }
    .voice-label {
      font-weight: 900;
      letter-spacing: 1.2px;
      color: rgba(139, 233, 253, 0.92);
      font-size: 12px;
      margin-bottom: 10px;
      text-transform: uppercase;
    }
    .midi-row {
      display: flex;
      gap: 10px;
      align-items: center;
      margin: 10px 0;
      flex-wrap: wrap;
    }
    .midi-row .mini {
      font-size: 12px;
      color: rgba(245, 247, 255, 0.88);
      opacity: 0.9;
      min-width: 95px;
      font-family: var(--wt-mono);
    }
    .ct-select,
    .ct-toggle {
      background: rgba(10, 12, 16, 0.35);
      color: rgba(245, 247, 255, 0.92);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 12px;
      padding: 10px 10px;
      font-family: var(--wt-ui-font);
      font-weight: 800;
      letter-spacing: 0.3px;
      outline: none;
    }
    .ct-select { min-width: 260px; max-width: 100%; }
    .ct-select:focus-visible,
    .ct-toggle:focus-visible {
      box-shadow: var(--wt-focus);
      border-color: rgba(76, 194, 255, 0.30);
    }
    .ct-toggle {
      cursor: pointer;
      border-color: rgba(255, 121, 198, 0.35);
      color: rgba(255, 121, 198, 0.95);
      background: rgba(255, 121, 198, 0.10);
      text-transform: uppercase;
    }
    .ct-toggle.on {
      background: rgba(255, 121, 198, 0.24);
      border-color: rgba(255, 121, 198, 0.50);
      color: rgba(245, 247, 255, 0.92);
    }
    .ct-toggle.voice {
      border-color: rgba(139, 233, 253, 0.35);
      color: rgba(139, 233, 253, 0.95);
      background: rgba(139, 233, 253, 0.10);
    }
    .ct-toggle.voice.on {
      background: rgba(139, 233, 253, 0.22);
      border-color: rgba(139, 233, 253, 0.50);
      color: rgba(245, 247, 255, 0.92);
